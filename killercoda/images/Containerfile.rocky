FROM quay.io/rockylinux/rockylinux:9
ENV container=podman

RUN dnf -y install --setopt=install_weak_deps=False \
      systemd openssh-server python3 sudo shadow-utils \
 && dnf clean all \
 && sed -i 's/^session\s\+required\s\+pam_loginuid.so/session optional pam_loginuid.so/' /etc/pam.d/sshd \
 && systemctl enable sshd.service \
 && useradd -m ansible \
 && install -d -m 0700 -o ansible -g ansible /home/ansible/.ssh \
 && printf 'ansible ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/ansible \
 && chmod 0440 /etc/sudoers.d/ansible

COPY --chown=ansible:ansible lab_ed25519.pub /home/ansible/.ssh/authorized_keys
RUN chmod 0600 /home/ansible/.ssh/authorized_keys

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
